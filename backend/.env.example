# Server Configuration
PORT=8000

# NanoBanana VTON API Configuration
# Leave empty to use placeholder, or set to your deployed NanoBanana API URL
NANOBANANA_API_URL=

# Example when deployed:
# NANOBANANA_API_URL=https://your-nanobanana-service.run.app/tryon

# Firebase Configuration (optional - for storing results)
FIREBASE_SERVICE_ACCOUNT_KEY=base64_encoded_service_account_key
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
