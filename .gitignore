# Root level gitignore for Ai-Wardrobe project

# Environment variables
.env
.env.local
.env.production
*.env

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node modules (if any in root)
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class

# Build outputs
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

# Documentation builds
docs/_build/

# Coverage
coverage/
.coverage
*.cover

# Service account keys
*serviceAccountKey*.json
firebase-adminsdk*.json

# Local development
.cache/
